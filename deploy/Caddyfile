{
	email admin@yanabourne.com
}

# Main marketing site (static build lives on the server separately)
www.yanabourne.com {
	redir https://yanabourne.com{uri} permanent
}

yanabourne.com {
	root * /srv/yanabourne/main
	encode gzip zstd
	file_server
}

photography.yanabourne.com {
	encode gzip zstd

	# Legacy Netlify image API → static /photos variants
	import legacy-image-redirects.caddy

	handle_path /photos/* {
		root * /srv/yanabourne/photos/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/yanabourne/photography
		try_files {path} {path}/ /index.html
		header Cache-Control "public, max-age=3600"
		file_server
	}
}